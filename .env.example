# Copy to .env, fill in the key, never commit it (`.env` is git-ignored).
# Anything here can also be passed as a normal environment variable; os.environ wins.

# Required for the agent. Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-replace-me

# Optional. Defaults shown. Any OpenAI-compatible endpoint works, including
# a local vLLM (http://127.0.0.1:8000/v1) or Ollama (http://127.0.0.1:11434/v1).
# FORECAST_LOG_BASE_URL=https://api.deepseek.com/v1
# FORECAST_LOG_MODEL=deepseek-chat
# FORECAST_LOG_API_KEY=

# Optional. USD per million tokens, if the defaults in agent/llm.py are out of date.
# FORECAST_LOG_PRICE_INPUT=0.28
# FORECAST_LOG_PRICE_OUTPUT=0.42
# FORECAST_LOG_PRICE_CACHED=0.028

# Optional second provider. Alibaba MaaS gateway: the chat path is /compatible-mode/v1,
# not /api/v1 (that one only serves /models).
# QWEN_API_KEY=sk-replace-me
# QWEN_BASE_URL=https://<your-maas-host>/compatible-mode/v1
# QWEN_MODEL=tongyi-xiaomi-analysis-flash
# QWEN_PRICE_INPUT=0.027
# QWEN_PRICE_OUTPUT=0.055
