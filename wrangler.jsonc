{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forecast",
  "main": "deploy/worker.mjs",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  // Supabase PostgreSQL via Cloudflare Hyperdrive:
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d8df72bbd63448ca94263f7a009557c3"
    }
  ],
  "placement": { "region": "aws:us-east-1" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forecast",
      "database_id": "12801a26-3679-42e2-a5ed-6941d495bd71"
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "forecast.lumixraku.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./deploy/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  }
}
