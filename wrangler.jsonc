{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forecast-log",
  "main": "deploy/worker.mjs",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./deploy/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  }
}
