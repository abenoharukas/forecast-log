{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forecast",
  "main": "deploy/worker.mjs",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forecast",
      "database_id": "6fb54e3a-687e-4510-bedb-150542baebde"
    }
  ],
  "assets": {
    "directory": "./deploy/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  }
}
