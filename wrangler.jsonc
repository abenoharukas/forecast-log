{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forecast",
  "main": "deploy/worker.mjs",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forecast",
      "database_id": "12801a26-3679-42e2-a5ed-6941d495bd71"
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "forecast.lumixraku.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./deploy/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  }
}
